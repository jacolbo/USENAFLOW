modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "gce"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5904
externalPort = 3000

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[agent]
integrations = ["google-calendar:1.0.0", "resend:1.0.0", "google-mail:1.0.0", "javascript_object_storage:2.0.0", "google-drive:1.0.0", "javascript_openai_ai_integrations:2.0.0"]

[userenv]

[userenv.shared]
APP_URL = "https://Usenaflow.replit.app"
VAPID_PUBLIC_KEY = "BKrMja12uzeSN_ukFSthpmn1pkYikyYUicDi5AIo0za3J14dhvpEwjoj-z_HV_VcrxHcu5XTW0C9dAVS7rjwS64"
VAPID_PRIVATE_KEY = "SET_VIA_REPLIT_SECRETS"
VITE_VAPID_PUBLIC_KEY = "BKrMja12uzeSN_ukFSthpmn1pkYikyYUicDi5AIo0za3J14dhvpEwjoj-z_HV_VcrxHcu5XTW0C9dAVS7rjwS64"

[objectStorage]
defaultBucketID = "replit-objstore-36146d31-ae4d-40c1-b92e-b20750c78157"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
